# FloMorphic environment
# Copy to `.env` and adjust.

# Base URL of the Inflowenger flomorphic-api backend.
# Leave empty to run standalone with browser-local persistence.
VITE_API_BASE_URL=

# HS256 bearer sent to the API when it runs with AUTH_ENABLED=true; must be a JWT
# signed with the API's API_JWT_SECRET. Leave empty when the API has auth off.
# Inlined into the bundle at build time, so it authenticates the install, not a user.
VITE_API_TOKEN=
